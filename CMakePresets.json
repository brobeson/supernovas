{
  "version": 12,
  "configurePresets": [
    {
      "name": "default",
      "hidden": true,
      "binaryDir": "build/${presetName}",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Configure a release build.",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Configure a debug build.",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SUPERNOVAS_BUILD_COVERAGE": true
      }
    },
    {
      "name": "visualStudio",
      "displayName": "Visual Studio",
      "description": "Configure a Visual Studio project.",
      "inherits": "default",
      "generator": "Visual Studio 18 2026",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Run a debug build.",
      "configuration": "Debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Run a release build.",
      "configuration": "Release",
      "configurePreset": "release"
    },
    {
      "name": "vs-debug",
      "displayName": "Visual Studio Debug",
      "description": "Run a debug build.",
      "configuration": "Debug",
      "configurePreset": "visualStudio"
    },
    {
      "name": "vs-release",
      "displayName": "Visual Studio Release",
      "description": "Run a release build.",
      "configuration": "Release",
      "configurePreset": "visualStudio"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "LLVM_PROFILE_FILE": "profiles/cov-%m-%p.profraw"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Run debug tests",
      "inherits": "default",
      "configuration": "Debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Run release tests",
      "inherits": "default",
      "configuration": "Release",
      "configurePreset": "release"
    },
    {
      "name": "vs-debug",
      "displayName": "Visual Studio Debug",
      "description": "Run debug tests",
      "inherits": "default",
      "configuration": "Debug",
      "configurePreset": "visualStudio"
    },
    {
      "name": "vs-release",
      "displayName": "Visual Studio Release",
      "description": "Run release tests",
      "inherits": "default",
      "configuration": "Release",
      "configurePreset": "visualStudio"
    }
  ],
  "workflowPresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Run a complete debug workflow.",
      "steps": [
        { "type": "configure", "name": "debug" },
        { "type": "build", "name": "debug" },
        { "type": "test", "name": "debug" }
      ]
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Run a complete release workflow.",
      "steps": [
        { "type": "configure", "name": "release" },
        { "type": "build", "name": "release" },
        { "type": "test", "name": "release" }
      ]
    },
    {
      "name": "vs-debug",
      "displayName": "Visual Studio Debug",
      "description": "Run a complete debug workflow.",
      "steps": [
        { "type": "configure", "name": "visualStudio" },
        { "type": "build", "name": "vs-debug" },
        { "type": "test", "name": "vs-debug" }
      ]
    },
    {
      "name": "vs-release",
      "displayName": "Visual Studio Release",
      "description": "Run a complete release workflow.",
      "steps": [
        { "type": "configure", "name": "visualStudio" },
        { "type": "build", "name": "vs-release" },
        { "type": "test", "name": "vs-release" }
      ]
    }
  ]
}
